# Staging API — copy to repo root as `.env.staging` or merge into `.env`
# Load order: .env → .env.local → .env.staging → .env.staging.local

APP_ENV=staging
NODE_ENV=production
PORT=5050
TRUST_PROXY=1

# Required in staging
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
JWT_SECRET=
SETTINGS_ENCRYPTION_KEY=
CORS_ORIGINS=https://staging.example.com,http://localhost:8080

# Strongly recommended
ADMIN_API_KEY=

# Swagger off by default in staging (same as production)
# ENABLE_API_DOCS=0

# Optional uploads fallback
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
