# Production API — copy to repo root as `.env.production` or use host secrets / systemd EnvironmentFile
# Never commit real secrets.

APP_ENV=production
NODE_ENV=production
PORT=5050
TRUST_PROXY=1

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
JWT_SECRET=
SETTINGS_ENCRYPTION_KEY=
CORS_ORIGINS=https://binofoundry.temukreatif.id

ADMIN_API_KEY=

# Keep off in public production (default). Set 1 only for temporary private debugging.
# ENABLE_API_DOCS=0

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
