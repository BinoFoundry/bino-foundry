# Frontend-only env (Vite) — copy to `.env.development.local`

# Express API origin (match backend PORT; avoid macOS AirPlay on 5000)
VITE_API_BASE_URL=http://localhost:5050

# Optional: same value as backend ADMIN_API_KEY for catalogue mutations from admin UI
# VITE_ADMIN_API_KEY=

# Optional: override API mount (default /api)
# VITE_API_PREFIX=/api

See [README.md](./README.md) and repo root [.env.example](../.env.example).
