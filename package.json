{
  "name": "bino-foundry",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "frontend",
    "backend",
    "shared"
  ],
  "scripts": {
    "dev": "npm run dev --workspace frontend",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "build": "npm run build:frontend",
    "build:frontend": "npm run build --workspace frontend",
    "build:backend": "npm run build --workspace backend",
    "build:all": "npm run build -w @bino-foundry/shared && npm run build -w @bino-foundry/backend && npm run build -w @bino-foundry/frontend",
    "build:staging": "npm run build -w @bino-foundry/shared && npm run build -w @bino-foundry/backend && npm run build:staging -w @bino-foundry/frontend",
    "preview": "npm run preview --workspace frontend",
    "lint": "npm run lint --workspace frontend",
    "test": "npm run test --workspace frontend",
    "test:watch": "npm run test:watch --workspace frontend",
    "test:e2e": "npm run test:e2e --workspace frontend",
    "server": "npm run start --workspace backend",
    "start:backend": "npm run start --workspace backend",
    "start:api:prod": "bash scripts/start-api-production.sh",
    "start:prod": "npm run start:api:prod",
    "env:check": "node scripts/check-env.mjs",
    "refresh:bead-assets": "node scripts/refresh-bead-assets.mjs",
    "deploy:build": "bash scripts/build-production.sh",
    "deploy:web": "bash scripts/sync-web-root.sh",
    "docker:api": "docker compose build api",
    "docker:up": "docker compose up -d",
    "typecheck:backend": "npm run typecheck --workspace backend"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
