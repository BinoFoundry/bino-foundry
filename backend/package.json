{
  "name": "@bino-foundry/backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "npm run build -w @bino-foundry/shared",
    "dev": "tsx watch src/server.ts",
    "prestart": "npm run build -w @bino-foundry/shared",
    "build": "npm run build -w @bino-foundry/shared && tsc",
    "start": "tsx src/server.ts",
    "start:prod": "node dist/server.js",
    "typecheck": "npm run build -w @bino-foundry/shared && tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@bino-foundry/shared": "*",
    "@supabase/supabase-js": "^2.49.10",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.9.0",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.11",
    "sharp": "^0.35.3",
    "swagger-ui-express": "^5.0.1",
    "tsx": "^4.20.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.16.5",
    "@types/nodemailer": "^8.0.1",
    "@types/swagger-ui-express": "^4.1.8",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
