# =============================================================================
# Bino Foundry — environment template (copy to `.env` at repo root)
# =============================================================================
# Load order: .env → .env.local → .env.{APP_ENV} → .env.{APP_ENV}.local
# See deploy/env/ for staging & production templates.
# Validate: npm run env:check

# development | staging | production
APP_ENV=development
NODE_ENV=development

# macOS: port 5000 is often AirPlay — use 5050 locally
PORT=5050

# Behind nginx/Caddy on VPS (set 1 in staging/production)
TRUST_PROXY=0

# Required when APP_ENV=staging|production (comma-separated SPA URLs)
# Local dev: leave empty OR include http://localhost:8080 — dev mode auto-allows localhost anyway
# Supabase Postgres + storage (Auth is NOT used — identity lives in `users` table)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Legacy — no longer required for authentication
SUPABASE_ANON_KEY=
# Public SPA URL for password-reset and email-verification links (defaults to first CORS origin)
PUBLIC_APP_URL=http://localhost:8080
# Application JWT signing secret (required in staging/production; min 32 chars)
JWT_SECRET=
# Base64-encoded 32-byte key for encrypting SMTP credentials at rest (required in staging/production)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SETTINGS_ENCRYPTION_KEY=
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30
CORS_ORIGINS=

# Recommended in staging/production (guards catalogue mutations)
ADMIN_API_KEY=

# Swagger UI + /api/openapi.json — on in development by default; off in staging/production.
# ENABLE_API_DOCS=0
# ENABLE_API_DOCS=1

# Optional image uploads fallback
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# -----------------------------------------------------------------------------
# Frontend (Vite) — also read from frontend/.env.development.local
# -----------------------------------------------------------------------------
# Vite merges root + frontend env files. If VITE_ADMIN_API_KEY is omitted here,
# the SPA build mirrors ADMIN_API_KEY automatically so writes send a matching x-api-key.
# Prefer VITE_API_BASE_URL (not VITE_BASE_URL).
# VITE_API_BASE_URL=http://localhost:5050
# VITE_API_PREFIX=/api
# VITE_ADMIN_API_KEY=
